# Copiá este archivo a .env para desarrollo local (no se commitea).
# En Render, estas mismas claves se cargan como Environment Variables del servicio.

APP_NAME=ANKOR API
ENVIRONMENT=development

# Cadena de conexión a Postgres. En Neon: copiá el "Connection string" del
# dashboard y cambiale el prefijo postgresql:// por postgresql+pg8000://
# (usamos el driver pg8000, en Python puro, sin dependencias nativas).
# El query param que activa TLS es ssl_context=true (session.py lo traduce a
# un ssl.SSLContext real antes de pasárselo a pg8000 — pg8000 no acepta el
# string "true" directamente, por eso NO alcanza con ?ssl=true).
# Ejemplo Neon:
# DATABASE_URL=postgresql+pg8000://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/ankor?ssl_context=true
DATABASE_URL=postgresql+pg8000://ankor:ankor@localhost:5432/ankor

# Dominios del frontend autorizados a llamar la API (separados por coma).
# En local: el puerto que uses para servir el frontend estático.
# En producción: la URL que te da Netlify, ej. https://ankor-ferreteria.netlify.app
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
